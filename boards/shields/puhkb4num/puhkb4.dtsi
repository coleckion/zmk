#include <dt-bindings/zmk/matrix_transform.h>
#include "puhkb4-layout.dtsi"

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layouts = &physical_layout0;
    };

    matrix_transform0: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <4>;
        rows = <4>;
// | SW1  | SW2  | SW3  | SW4  |
// | SW5  | SW6  | SW7  | SW8  |
// | SW9  | SW10 | SW11 | SW12 |
// | SW13 | SW14 | SW15 | SW16 |
        map = <
RC(0,1) RC(0,2) RC(0,3) RC(0,4)
RC(1,1) RC(1,2) RC(1,3) RC(1,4)
RC(2,1) RC(2,2) RC(2,3) RC(2,4)
RC(3,1) RC(3,2) RC(3,3) RC(3,4)
        >;
    };
	
	kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";
    };
};
