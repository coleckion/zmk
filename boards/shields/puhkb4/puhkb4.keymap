#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>

&led_strip {
    chain-length = <23>;
};

#define BASE 0
#define LF1 1
#define LF2 2
#define LF3 3
#define LF4 4
#define RF1 5
#define RF2 6
#define RF3 7
#define RF4 8
#define GAM 9
#define GAM2 10

/ {

	conditional_layers {
		compatible = "zmk,conditional-layers";
		lf3_layer {
			if-layers = <LF1 LF2>;
			then-layer = <LF3>;
		};
		rf3_layer {
			if-layers = <RF1 RF2>;
			then-layer = <RF3>;
        };
    };
    
	behaviors {
		td0: tap_dance_0 {
            		compatible = "zmk,behavior-tap-dance";
            		#binding-cells = <0>;
			tapping-term-ms = <500>;
            		bindings = <&kp KP_PLUS>, <&kp KP_MULTIPLY>;
        	};
        td1: tap_dance_1 {
            		compatible = "zmk,behavior-tap-dance";
            		#binding-cells = <0>;
            		tapping-term-ms = <500>;
            		bindings = <&kp KP_MINUS>, <&kp KP_DIVIDE>;
        	};
		td2: tap_dance_2 {
            		compatible = "zmk,behavior-tap-dance";
            		#binding-cells = <0>;
            		tapping-term-ms = <500>;
            		bindings = <&kp KP_DOT>, <&kp COMMA>;
        	};
        skq: sticky_key_quick_release {
        		compatible = "zmk,behavior-sticky-key";
        		#binding-cells = <1>;
        		bindings = <&kp>;
        		release-after-ms = <3000>;
        		quick-release;
        		ignore-modifiers;
      		};
    };
    
	keymap {
		compatible = "zmk,keymap";
        
		default_layer {
			display-name = "BASE";
// * BASE
// * |-------------------------------------------|       |-------------------------------------------|       |-----------------------------|
// *   | ESC  |   Q  |   W  |   E  |   R  |   T  |         |   Y  |   U  |   I  |   O  |  ;:  | BSP  |         |  N7  |  N8  |  N9  |  +   |
// * |---------------------------------------------|     |---------------------------------------------|     |-------------------------------|
// *     | TAB  |   A  |   S  |   D  |   F  |   G  |         |   H  |   J  |   K  |   L  |  P   |  '"  |         |  N4  |  N5  |  N6  |  -   |
// * |---------------------------------------------|     |---------------------------------------------|     |-------------------------------|
// * |LShift|RShift|   Z  |   X  |   C  |   V  |         |  B   |   N  |   M  |  ,<  |  .>  |  /?  |         |  *   |  N1  |  N2  |  N3  |
// * |-----------------------------------------|         |-----------------------------------------|         |---------------------------|
// * |LCTRL | LGUI | LAlt | LF2  | LF1  | SPC  |         |Space |Space |  RF1 | RF2  | RAlt |RShift|         |  /   |  N0  |  .,  | RET/1|
// * |-----------------------------------------|         |-----------------------------------------|         |---------------------------|
// * |xxxxxx| DOWN | RIGH | PUSH | LEFT | UP   |         |xxxxxx| VOL- | NEXT | PLAY | BACK | VOL+ |         |xxxxxx|xxxxxx|xxxxxx|xxxxxx|
// * |-----------------------------------------|         |-----------------------------------------|         |---------------------------|
// */
            bindings = <
&kp ESC   &kp Q     &kp W     &kp E    &kp R     &kp T       &kp Y     &kp U        &kp I      &kp O        &kp SEMI   &kp BSPC       &kp KP_N7       &kp KP_N8 &kp KP_N9 &kp KP_PLUS
&kp TAB   &kp A     &kp S     &kp D    &kp F     &kp G       &kp H     &kp J        &kp K      &kp L        &kp P      &kp SQT        &kp KP_N4       &kp KP_N5 &kp KP_N6 &kp KP_MINUS
&kp LSHFT &kp RSHFT &kp Z     &kp X    &kp C     &kp V       &kp B     &kp N        &kp M      &kp COMMA    &kp DOT    &kp FSLH       &kp KP_MULTIPLY &kp KP_N1 &kp KP_N2 &kp KP_N3
&kp LCTRL &kp LGUI  &kp LALT  &mo LF2  &mo LF1   &kp SPACE   &kp SPACE &kp SPACE    &mo RF1    &mo LF2      &kp RALT   &kp RSHFT      &kp KP_DIVIDE   &kp KP_N0 &td2      &lt 1 RET
          &kp UP    &kp RET   &kp LEFT &kp DOWN  &kp RIGHT             &kp C_VOL_UP &kp C_PP  &kp C_PREV &kp C_VOL_DN &kp C_NEXT    
            >;
        };

		lf1_layer {
			display-name = "LF1";
// * LF1
// * |-------------------------------------------|       |-------------------------------------------|       |-----------------------------|
// *   | BSP  |  UP  | DEL  |   7  |   8  |   9  |         |  N7  |  N8  |  N9  |  N+  |  N*  | DEL  |         |  N7  |  N8  |  N9  |  +   |
// * |---------------------------------------------|     |---------------------------------------------|     |-------------------------------|
// *     | LEF  |  DOW |  RIG |   4  |   5  |   6  |         |  N4  |  N5  |  N6  |  N-  |  N/  |xxxxxx|         |  N4  |  N5  |  N6  |  -   |
// * |---------------------------------------------|     |---------------------------------------------|     |-------------------------------|
// * |LShift|  TD2 |   0  |   1  |   2  |   3  |         |  NUM |  N1  |  N2  |  N3  |  N0  | TD2  |         |  *   |  N1  |  N2  |  N3  |
// * |-----------------------------------------|         |-----------------------------------------|         |---------------------------|
// * |LCTRL | LGUI | LAlt | LF2  | LF1  | SPC  |         |Space |Space |  RF1 | RF2  | RAlt |RShift|         |  /   |  N0  |  .,  | RET/1|
// * |-----------------------------------------|         |-----------------------------------------|         |---------------------------|
// * |xxxxxx| DOWN | RIGH | PUSH | LEFT | UP   |         |xxxxxx| DOWN | RIGH | PUSH | LEFT | UP   |         |xxxxxx|xxxxxx|xxxxxx|xxxxxx|
// * |-----------------------------------------|         |-----------------------------------------|         |---------------------------|
// */
            bindings = <
&kp BSPC  &kp UP    &kp DEL   &kp N7  &kp N8   &kp N9      &kp Y      &kp U     &kp I     &kp O     &kp SEMI  &kp BSPC     &kp KP_N7       &kp KP_N8 &kp KP_N9 &kp KP_PLUS
&kp LEFT  &kp DOWN  &kp RIGHT &kp N4  &kp N5   &kp N6      &kp H      &kp J     &kp K     &kp L     &kp P     &kp SQT      &kp KP_N4       &kp KP_N5 &kp KP_N6 &kp KP_MINUS
&kp LSHFT &td0      &kp N0    &kp N1  &kp N2   &kp N3      &kp B      &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH     &kp KP_MULTIPLY &kp KP_N1 &kp KP_N2 &kp KP_N3
&kp LCTRL &kp LGUI  &kp LALT  &mo LF2 &mo LF1  &kp SPACE   &kp KP_NUM &kp SPACE &mo RF1   &mo LF2   &kp RALT  &kp RSHFT    &kp KP_DIVIDE   &kp KP_N0 &td2      &lt 1 RET
&none     &kp DOWN  &kp RIGHT &kp RET &kp LEFT &kp UP      &none      &kp DOWN  &kp RIGHT &kp RET   &kp LEFT  &kp UP       &none           &none     &none     &none
            >;
        };
        
		lf2_layer {
			display-name = "LF2";
// * LF2
// * |-------------------------------------------|       |-------------------------------------------|       |-----------------------------|
// *   |  !   |   @  |   #  |   $  |   %  |   ^  |         |   -  |   _  |   /  |   ?  |  \   |  |   |         |  N7  |  N8  |  N9  |  +   |
// * |---------------------------------------------|     |---------------------------------------------|     |-------------------------------|
// *     |  &   |   *  |   (  |   )  |   =  |   +  |         |   [  |   ]  |   {  |   }  |  `   |  ~   |         |  N4  |  N5  |  N6  |  -   |
// * |---------------------------------------------|     |---------------------------------------------|     |-------------------------------|
// * |  F1  |  F2  |  F3  |  F4  |  F5  |  F6  |         |  F7  |  F8  |  F9  |  F10 |  F11 |  F12 |         |  *   |  N1  |  N2  |  N3  |
// * |-----------------------------------------|         |-----------------------------------------|         |---------------------------|
// * |LCTRL | LGUI | LAlt | LF2  | LF1  | SPC  |         |Space |Space |  RF1 | RF2  | RAlt |RShift|         |  /   |  N0  |  .,  | RET/1|
// * |-----------------------------------------|         |-----------------------------------------|         |---------------------------|
// * |xxxxxx| DOWN | RIGH | PUSH | LEFT | UP   |         |xxxxxx| DOWN | RIGH | PUSH | LEFT | UP   |         |xxxxxx|xxxxxx|xxxxxx|xxxxxx|
// * |-----------------------------------------|         |-----------------------------------------|         |---------------------------|
// */
            bindings = <
&kp ESC   &kp Q     &kp W     &kp E   &kp R    &kp T       &kp Y     &kp U     &kp I     &kp O     &kp SEMI  &kp BSPC     &kp KP_N7       &kp KP_N8 &kp KP_N9 &kp KP_PLUS
&kp TAB   &kp A     &kp S     &kp D   &kp F    &kp G       &kp H     &kp J     &kp K     &kp L     &kp P     &kp SQT      &kp KP_N4       &kp KP_N5 &kp KP_N6 &kp KP_MINUS
&kp LSHFT &kp RSHFT &kp Z     &kp X   &kp C    &kp V       &kp B     &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH     &kp KP_MULTIPLY &kp KP_N1 &kp KP_N2 &kp KP_N3
&kp LCTRL &kp LGUI  &kp LALT  &mo LF2 &mo LF1  &kp SPACE   &kp SPACE &kp SPACE &mo RF1   &mo LF2   &kp RALT  &kp RSHFT    &kp KP_DIVIDE   &kp KP_N0 &td2      &lt 1 RET
&none     &kp DOWN  &kp RIGHT &kp RET &kp LEFT &kp UP      &none     &kp DOWN  &kp RIGHT &kp RET   &kp LEFT  &kp UP       &none           &none     &none     &none
            >;
        };
        
		lf3_layer {
			display-name = "LF3";
// * LF3
// * |-------------------------------------------|       |-------------------------------------------|       |-----------------------------|
// *   | MUTE | PLAY | VUP  | VDO  |SUNLO | BTCL |         |xxxxxx| CapL | BriU |  PS  |  PUP | Home |         |  N7  |  N8  |  N9  |  +   |
// * |---------------------------------------------|     |---------------------------------------------|     |-------------------------------|
// *     | GAME |RGBTOG| BTS0 | BTS1 | BTS2 | BTS3 |         |xxxxxx| ScrL | BriD | Ins  |  PDO |  End |         |  N4  |  N5  |  N6  |  -   |
// * |---------------------------------------------|     |---------------------------------------------|     |-------------------------------|
// * |RGBBRI|RGBBRD| BTD0 | BTD1 | BTD2 | BTD3 |         |xxxxxx|xxxxxx|xxxxxx|xxxxxx|xxxxxx|xxxxxx|         |  *   |  N1  |  N2  |  N3  |
// * |-----------------------------------------|         |-----------------------------------------|         |---------------------------|
// * |RGBSPI|RGBSPD|RGBEFF| LF2  | LF1  | SPC  |         |Space |Space |  RF1 | RF2  |xxxxxx|xxxxxx|         |  /   |  N0  |  .,  | RET/1|
// * |-----------------------------------------|         |-----------------------------------------|         |---------------------------|
// * |xxxxxx| DOWN | RIGH | PUSH | LEFT | UP   |         |xxxxxx| DOWN | RIGH | PUSH | LEFT | UP   |         |xxxxxx|xxxxxx|xxxxxx|xxxxxx|
// * |-----------------------------------------|         |-----------------------------------------|         |---------------------------|
// */
            bindings = <
&kp ESC   &kp Q     &kp W     &kp E   &kp R    &kp T       &kp Y     &kp U     &kp I     &kp O     &kp SEMI  &kp BSPC     &kp KP_N7       &kp KP_N8 &kp KP_N9 &kp KP_PLUS
&kp TAB   &kp A     &kp S     &kp D   &kp F    &kp G       &kp H     &kp J     &kp K     &kp L     &kp P     &kp SQT      &kp KP_N4       &kp KP_N5 &kp KP_N6 &kp KP_MINUS
&kp LSHFT &kp RSHFT &kp Z     &kp X   &kp C    &kp V       &kp B     &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH     &kp KP_MULTIPLY &kp KP_N1 &kp KP_N2 &kp KP_N3
&kp LCTRL &kp LGUI  &kp LALT  &mo LF2 &mo LF1  &kp SPACE   &kp SPACE &kp SPACE &mo RF1   &mo LF2   &kp RALT  &kp RSHFT    &kp KP_DIVIDE   &kp KP_N0 &td2      &lt 1 RET
&none     &kp DOWN  &kp RIGHT &kp RET &kp LEFT &kp UP      &none     &kp DOWN  &kp RIGHT &kp RET   &kp LEFT  &kp UP       &none           &none     &none     &none
            >;
        };
        
        extra1 {
            status = "reserved";
        };

        extra2 {
            status = "reserved";
        };
    };
};
